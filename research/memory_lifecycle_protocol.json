{
  "schema": "ohm-memory-lifecycle-protocol-v1",
  "scope": "Authored diagnostic session stream, lexical retrieval, experimental lifecycle only",
  "seeds": [7, 23, 101],
  "capacities": [8, 16],
  "policies": ["full", "fifo", "lru", "lfu", "decay", "decay_probe", "decay_replay"],
  "recovery_rows": 4,
  "maintenance_rows": 8,
  "maintenance_every": 4,
  "history_queries": 8,
  "half_life": 24.0,
  "threshold": 0.45,
  "max_records": 10000,
  "max_text_chars": 4096,
  "top_k": 1,
  "tuning": "None; results are diagnostic, not a sealed generalization evaluation"
}
